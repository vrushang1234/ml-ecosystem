{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "CMake: Build",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "type": "shell",
      "label": "g++: Build All Sources (UCRT64)",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-I${workspaceFolder}/include",
        "${workspaceFolder}/src/main.cpp",
        "${workspaceFolder}/src/ast.cpp",
        "${workspaceFolder}/src/parser.cpp",
        "${workspaceFolder}/src/sema.cpp",
        "-o",
        "${workspaceFolder}/bin/compiler.exe"
      ],
      "group": "build",
      "problemMatcher": "$gcc"
    }
  ]
}
