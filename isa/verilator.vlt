`verilator_config
// Known RTL issues, waived so lint stays strict for everything else:
// - decode.sv declares output `out` but never drives it
// - decode.sv ignores instruction[11:8]
lint_off -rule UNDRIVEN -file "*/decode.sv" -match "*'out'*"
lint_off -rule UNUSEDSIGNAL -file "*/decode.sv" -match "*instruction*"
